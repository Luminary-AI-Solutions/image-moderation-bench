# Jev: OpenRouter API key (Jev's Decisions API endpoint)
OPENROUTER_API_KEY=

# Claude Haiku 5.5: Anthropic API key
ANTHROPIC_API_KEY=

# Amazon Rekognition: an IAM user's access key allowed rekognition:DetectModerationLabels
